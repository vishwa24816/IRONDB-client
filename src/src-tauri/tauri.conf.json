{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRONDB",
  "version": "0.1.0",
  "identifier": "com.irondb.app",
  "build": {
    "frontendDist": "../frontend-vanilla/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "IRONDB",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "externalBin": ["../target/release/irondb-headless"],
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "UPDATER_PUBKEY_PLACEHOLDER"
    }
  }
}
